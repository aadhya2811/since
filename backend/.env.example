# Copy to backend/.env for local dev. All keys are optional.
SINCE_PROVIDER=yahoo
SINCE_FALLBACK_PROVIDER=simulated
SINCE_NEWS_PROVIDER=google
SINCE_NEWS_FALLBACK_PROVIDER=simulated
SINCE_DATABASE_URL=sqlite:///./since.db
SINCE_AUTH_DEV_RETURN_CODE=true
SINCE_LOG_LEVEL=INFO

# --- email (optional) -------------------------------------------------
# Leave SINCE_SMTP_HOST empty and login codes are shown in the app.
# Fill these in to send real mail. Gmail: use an App Password, not your
# account password (Google account → Security → 2-Step → App passwords).
# SINCE_SMTP_HOST=smtp.gmail.com
# SINCE_SMTP_PORT=587
# SINCE_SMTP_USER=you@gmail.com
# SINCE_SMTP_PASSWORD=your-16-char-app-password
# SINCE_SMTP_FROM=you@gmail.com
# SINCE_SMTP_FROM_NAME=Since
# SINCE_AUTH_DEV_RETURN_CODE=false     # stop echoing the code once mail works
